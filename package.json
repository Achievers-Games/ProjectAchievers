{
  "name": "project-achievers",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:db": "node scripts/dev-db.mjs",
    "build": "vite build",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint src e2e",
    "format": "prettier --write \"src/**/*.{ts,svelte,css,html}\"",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e-db.mjs && playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@lucide/svelte": "^1.65.0",
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.5",
    "marked": "^18.0.0",
    "pg-boss": "^12.0.0",
    "prisma": "^5.22.0",
    "psn-api": "^2.18.1",
    "sanitize-html": "^2.18.1",
    "simple-icons": "^16.36.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.43.0",
    "@sveltejs/adapter-node": "^5.2.0",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^22.0.0",
    "@types/sanitize-html": "^2.13.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "autoprefixer": "^10.4.19",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.12.0",
    "globals": "^17.13.0",
    "postcss": "^8.4.38",
    "prettier": "^3.2.0",
    "prettier-plugin-svelte": "^3.3.0",
    "svelte": "^5.20.0",
    "svelte-check": "^4.1.0",
    "svelte-eslint-parser": "^1.3.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
