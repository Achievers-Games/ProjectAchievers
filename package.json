{
  "name": "project-achievers",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "vite dev",
    "dev:db": "node scripts/dev-db.mjs",
    "build": "vite build",
    "start": "node build",
    "check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/test-db.mjs && vitest run",
    "test:coverage": "node scripts/test-db.mjs && vitest run --coverage",
    "test:e2e": "node scripts/test-db.mjs && playwright test",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@lucide/svelte": "^1.65.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "marked": "^18.0.0",
    "nodemailer": "^10.3.1",
    "pg-boss": "^12.0.0",
    "prisma": "^7.10.1",
    "psn-api": "^2.18.1",
    "sanitize-html": "^2.18.1",
    "simple-icons": "^16.36.0",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@iconify-json/game-icons": "^1.2.4",
    "@inlang/paraglide-js": "^3.1.0",
    "@inlang/plugin-message-format": "^4.6.0",
    "@playwright/test": "^1.43.0",
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.13.0",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.1.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "pg": "^8.23.1",
    "prettier": "^3.2.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.20.0",
    "svelte-check": "^4.1.0",
    "svelte-eslint-parser": "^1.10.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*",
    "#prisma": "./prisma/generated/client/client.ts"
  }
}
