  "sync_done": "{platform} 已是最新。",
  "sync_gained": [
    {
      "declarations": [
        "input count",
        "input platform",
        "local c = count: plural",
        "local n = count: number"
      ],
      "selectors": ["c"],
      "match": {
        "c=*": "{platform} 上有 {n} 个新成就！"
      }
    }
  ],
  "sync_failed": "同步失败。",
