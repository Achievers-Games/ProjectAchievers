  "sync_xbox_expired": "你的 Xbox 授权已过期，请重新连接账户。",
  "more_cards": [
    {
      "declarations": ["input count", "local c = count: plural", "local n = count: number"],
      "selectors": ["c"],
      "match": {
        "c=*": "+ 另外 {n} 项解锁"
      }
    }
  ],
  "count_games": [
    {
      "declarations": ["input count", "local c = count: plural", "local n = count: number"],
      "selectors": ["c"],
      "match": {
        "c=*": "{n} 款游戏"
      }
    }
  ],
  "count_achievements": [
    {
      "declarations": ["input count", "local c = count: plural", "local n = count: number"],
      "selectors": ["c"],
      "match": {
        "c=*": "{n} 个成就"
      }
    }
  ],
  "count_players": [
    {
      "declarations": ["input count", "local c = count: plural", "local n = count: number"],
      "selectors": ["c"],
      "match": {
        "c=*": "{n} 名玩家"
      }
    }
  ],
  "count_guides": [
    {
      "declarations": ["input count", "local c = count: plural", "local n = count: number"],
      "selectors": ["c"],
      "match": {
        "c=*": "{n} 篇攻略"
      }
    }
  ],
  "count_comments": [
    {
      "declarations": ["input count", "local c = count: plural", "local n = count: number"],
      "selectors": ["c"],
      "match": {
        "c=*": "{n} 条评论"
      }
    }
  ],
  "count_points": [
    {
      "declarations": ["input count", "local c = count: plural", "local n = count: number"],
      "selectors": ["c"],
      "match": {
        "c=*": "{n} 分"
      }
    }
  ],
  "count_sessions_closed": [
    {
      "declarations": ["input count", "local c = count: plural", "local n = count: number"],
      "selectors": ["c"],
      "match": {
        "c=*": "已退出 {n} 个会话。"
      }
    }
  ],
