generator client {
  provider     = "prisma-client"
  output       = "./generated/client"
  // Le projet est en ESM. Le générateur lit malgré tout le tsconfig le plus proche de
  // `output` : `prisma/generated/tsconfig.json` coupe court à celui de SvelteKit.
  moduleFormat = "esm"
}

// Depuis Prisma 7, l'URL de connexion vit dans `prisma.config.ts` ; le client, lui,
// passe par le pilote `pg` (`@prisma/adapter-pg`), sans moteur binaire par architecture.
datasource db {
  provider = "postgresql"
}

enum Provider {
  STEAM
  DISCORD
  PSN
  XBOX
  GOOGLE
  RETRO
  EPIC
  BLIZZARD
}

enum Platform {
  STEAM
  PSN
  XBOX
  RETRO
  BLIZZARD
}

enum TrophyType {
  PLATINUM
  GOLD
  SILVER
  BRONZE
  ACHIEVEMENT
}

enum SyncStatus {
  IDLE
  QUEUED
  SYNCING
  COMPLETED
  FAILED
  NEEDS_RELINK
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

/// Ce que peut faire un membre dans son clan : le chef seul renomme et nomme les officiers.
enum ClanRole {
  OWNER
  OFFICER
  MEMBER
}

enum ContentStatus {
  PUBLISHED
  HIDDEN
  DELETED
}

enum ReactionType {
  HELPFUL
  THANKS
  FUNNY
}

enum FeedbackKind {
  BUG
  IDEA
}

enum FeedbackArea {
  ACCOUNT
  SYNC
  GAMES
  ACHIEVEMENTS
  COMMUNITY
  SEASON
  NOTIFICATIONS
  OTHER
}

enum FeedbackStatus {
  NEW
  PLANNED
  DONE
  DECLINED
}

enum ReportTarget {
  GUIDE
  COMMENT
  MESSAGE
}

// ── Comptes ────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(cuid())
  handle              String    @unique
  displayName         String
  avatarUrl           String?
  /// Version animée de `avatarUrl`, chargée seulement quand elle doit jouer.
  avatarMotionUrl     String?
  /// Cadre équipé : un identifiant de `frames`, ou l'image d'un cadre importé d'un compte.
  frameMotionUrl      String?
  frame               String?
  isPublic            Boolean   @default(true)
  /// Vitrine choisie à la main ; sinon, les meilleures cartes.
  showcaseCustom      Boolean   @default(false)
  /// Affiche les jeux centrés sur le contenu sexuel, masqués par défaut.
  showAdult           Boolean   @default(false)
  /// Montre les messages tels qu'ils ont été écrits ; sinon, les grossièretés sont masquées.
  allowProfanity      Boolean   @default(false)
  /// Fuseau du navigateur : certains succès du site dépendent de l'heure du joueur.
  timeZone            String?
  friendsSeenAt       DateTime?
  clansSeenAt         DateTime?
  /// Dernière lecture du centre de notifications : succès et jeux terminés avant cette date sont vus.
  notificationsSeenAt DateTime?
  role                Role      @default(USER)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accounts      LinkedAccount[]
  partnerLinks  PartnerLink[]
  oauthGrants   OAuthGrant[]
  partnerEvents PartnerEvent[]
  sessions      Session[]
  games         UserGame[]
  achievements  UserAchievement[]
  guides        Guide[]
  guideVotes    GuideVote[]
  guideChecks   GuideCheck[]
  comments      Comment[]
  reactions     CommentReaction[]
  reports       Report[]
  syncRuns      SyncRun[]
  frames        UserFrame[]
  siteUnlocks   SiteUnlock[]
  pinned        PinnedGame[]

  friendRequests Friendship[]         @relation("FriendRequester")
  friendReceived Friendship[]         @relation("FriendAddressee")
  blocks         Block[]              @relation("Blocker")
  blockedBy      Block[]              @relation("Blocked")
  clanMember     ClanMember?
  clanInvites    ClanInvite[]
  clanRequests   ClanRequest[]
  conversations  ConversationMember[]
  messages       Message[]

  showOnline        Boolean            @default(true)
  feedback          Feedback[]
  pushMessages      Boolean            @default(true)
  pushInvites       Boolean            @default(true)
  pushEvents        Boolean            @default(true)
  pushSubscriptions PushSubscription[]
}

/// Un navigateur abonné aux notifications. Lié à la session : se déconnecter l'arrête.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  locale    String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Un bug ou une idée envoyés par un joueur à l'équipe.
model Feedback {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      FeedbackKind
  area      FeedbackArea   @default(OTHER)
  status    FeedbackStatus @default(NEW)
  content   String
  /// Le navigateur aide à reproduire un bug.
  userAgent String?
  createdAt DateTime       @default(now())

  @@index([status, createdAt])
  @@index([userId])
}

/// Une annonce envoyée à tous : elle ne part qu'une fois.
model Announcement {
  key    String   @id
  sentAt DateTime @default(now())
}

/// Une demande d'ami, acceptée ou non : un couple de joueurs n'a qu'une ligne.
model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User     @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  accepted    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model Block {
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model Clan {
  id           String    @id @default(cuid())
  name         String    @unique
  slug         String    @unique
  createdAt    DateTime  @default(now())
  /// Le nom retiré par la modération : tant qu'il est là, le chef doit en choisir un autre.
  flaggedName  String?
  /// L'emblème, déjà réduit à 256 px par le navigateur ; servi par /clans/<slug>/image.
  image        Bytes?
  imageType    String?
  imageAt      DateTime?
  /// L'analyse automatique n'a pas su trancher : l'emblème attend la modération.
  imagePending Boolean   @default(false)
  /// Le plus beau cadre gagné par le clan, porté par l'emblème.
  frame        String?

  members      ClanMember[]
  invites      ClanInvite[]
  requests     ClanRequest[]
  unlocks      ClanUnlock[]
  conversation Conversation?
}

/// Un succès gagné par le clan entier : ses membres du moment le reçoivent aussi.
model ClanUnlock {
  clanId     String
  clan       Clan     @relation(fields: [clanId], references: [id], onDelete: Cascade)
  code       String
  unlockedAt DateTime @default(now())

  @@id([clanId, code])
}

/// Un joueur appartient à un seul clan à la fois.
model ClanMember {
  userId   String   @id
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clanId   String
  clan     Clan     @relation(fields: [clanId], references: [id], onDelete: Cascade)
  role     ClanRole @default(MEMBER)
  joinedAt DateTime @default(now())

  @@index([clanId])
}

model ClanInvite {
  clanId    String
  clan      Clan     @relation(fields: [clanId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([clanId, userId])
  @@index([userId])
}

/// Une demande d'adhésion : elle ne demande pas d'être ami avec le chef.
model ClanRequest {
  clanId    String
  clan      Clan     @relation(fields: [clanId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([clanId, userId])
  @@index([userId])
}

/// Une discussion entre deux amis (directKey) ou celle d'un clan (clanId).
model Conversation {
  id        String   @id @default(cuid())
  directKey String?  @unique
  clanId    String?  @unique
  clan      Clan?    @relation(fields: [clanId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content        String
  /// Langue de l'auteur, pour appliquer le bon filtre de grossièretés.
  locale         String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([createdAt])
}

/// Cartes choisies par le joueur pour sa vitrine, dans l'ordre qu'il a décidé.
model PinnedGame {
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId   String
  game     Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  position Int

  @@id([userId, gameId])
}

/// Un succès du site obtenu ; le catalogue est dans `$lib/site-achievements`.
model SiteUnlock {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String
  /// Ce qui a déclenché le succès : identifiants de jeux et de succès de jeu.
  proof      Json?
  unlockedAt DateTime @default(now())

  @@id([userId, code])
  @@index([code])
}

model UserFrame {
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  frame    String
  earnedAt DateTime @default(now())

  @@id([userId, frame])
}

/// L'identifiant est le SHA-256 du jeton du cookie : une fuite de la base
/// ne permet pas de rejouer une session.
model Session {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  pushSubscriptions PushSubscription[]

  @@index([userId])
  @@index([expiresAt])
}

model LinkedAccount {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        Provider
  providerUserId  String
  displayName     String
  avatarUrl       String?
  avatarMotionUrl String?
  frameUrl        String?
  frameMotionUrl  String?
  profileUrl      String?
  /// Personnages WoW : leur liste exige le jeton du joueur, disponible seulement à la liaison.
  characters      Json?
  accessTokenEnc  String?
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?
  syncStatus      SyncStatus @default(IDLE)
  syncError       String?
  lastSyncedAt    DateTime?
  /// Steam : dernière recherche des jeux joués hors bibliothèque, partagés en famille surtout.
  sharedCheckedAt DateTime?
  /// Steam : dernier balayage de toute la boutique pour cette recherche.
  storeSweptAt    DateTime?
  linkedAt        DateTime   @default(now())

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
}

/// Le compte d'un joueur sur un site partenaire : même personne, deux bases, deux sites.
/// Aucun e-mail ni pseudo n'entre ici : seul un identifiant de compte partenaire, obtenu en
/// prouvant la même identité OAuth des deux côtés.
model PartnerLink {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// « lure »
  partner       String
  partnerUserId String
  /// AUTO quand une identité OAuth commune l'a prouvé, MANUAL sinon.
  method        String
  createdAt     DateTime  @default(now())
  /// Délié par le joueur : la ligne reste pour que la connexion suivante ne relie pas de nouveau.
  revokedAt     DateTime?

  @@unique([partner, partnerUserId])
  @@unique([userId, partner])
  @@index([userId])
}

/// Vérification de propriété d'un identifiant PSN par un code à placer dans
/// la bio du profil.
/// Preuve de possession d'un compte sans connexion OAuth : un code à poser sur son profil.
model PsnVerification {
  userId    String   @id
  provider  Provider @default(PSN)
  onlineId  String
  accountId String
  code      String
  expiresAt DateTime
}

// ── Catalogue ──────────────────────────────────────────────────────────

model Game {
  /// Rareté commune à la famille, de 1 à 6 : moyenne du taux le plus rare par plateforme.
  tier              Int?
  id                String            @id @default(cuid())
  platform          Platform
  platformGameId    String
  /// Les consoles d'une liste PSN (« PS4/PS5 ») : chacune compte pour un exemplaire à part.
  console           String?
  pinnedBy          PinnedGame[]
  translations      GameTranslation[]
  name              String
  slug              String            @unique
  coverUrl          String?
  headerUrl         String?
  totalAchievements Int               @default(0)
  schemaSyncedAt    DateTime?
  /// Classification Steam : nudité fréquente ou contenu réservé aux adultes.
  adultOnly         Boolean           @default(false)
  contentCheckedAt  DateTime?
  /// Étiquettes Steam les plus votées, par ordre de poids : les genres des succès du site.
  tags              Int[]             @default([])
  tagsCheckedAt     DateTime?
  /// Les succès manquables du jeu ont été relevés par un guide officiel.
  guideReviewedAt   DateTime?
  /// Clé commune aux versions d'un même jeu sur plusieurs plateformes.
  familyKey         String?
  /// Corrigée par la modération : la synchronisation n'y touche plus.
  familyLocked      Boolean           @default(false)
  /// Rattaché à sa famille par une liste de succès identique : le nom ne la recalcule plus.
  familyMatched     Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  achievements Achievement[]
  players      UserGame[]
  guides       Guide[]

  @@unique([platform, platformGameId])
  @@index([name])
  @@index([adultOnly])
  @@index([familyKey])
}

/// Jeux dont les textes ont déjà été demandés à la plateforme, même sans résultat.
model GameTranslation {
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  locale    String
  checkedAt DateTime @default(now())

  @@id([gameId, locale])
}

/// Nom et description officiels d'un succès dans une autre langue.
model AchievementTranslation {
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  locale        String
  name          String
  description   String      @default("")

  @@id([achievementId, locale])
}

model Achievement {
  id                    String     @id @default(cuid())
  gameId                String
  game                  Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  platformAchievementId String
  name                  String
  description           String     @default("")
  iconUrl               String?
  iconLockedUrl         String?
  hidden                Boolean    @default(false)
  trophyType            TrophyType @default(ACHIEVEMENT)
  globalRarity          Float?
  points                Int        @default(10)
  /// Peut être perdu pour la partie en cours : signalé par un guide officiel.
  missable              Boolean    @default(false)

  unlocks      UserAchievement[]
  translations AchievementTranslation[]
  guides       Guide[]
  comments     Comment[]

  @@unique([gameId, platformAchievementId])
  @@index([gameId])
}

model UserGame {
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId                String
  game                  Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  unlockedCount         Int       @default(0)
  totalCount            Int       @default(0)
  completion            Float     @default(0)
  platinum              Boolean   @default(false)
  playtimeMinutes       Int       @default(0)
  lastPlayedAt          DateTime?
  /// Dernière lecture réussie des succès chez le fournisseur, distincte du temps de jeu.
  achievementsCheckedAt DateTime?
  lastUnlockedAt        DateTime?
  updatedAt             DateTime  @updatedAt
  /// Retiré de la bibliothèque par le joueur, sans toucher à sa progression.
  hidden                Boolean   @default(false)

  @@id([userId, gameId])
  @@index([userId, lastUnlockedAt])
  @@index([gameId])
  @@index([lastUnlockedAt])
}

model UserAchievement {
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime
  /// Arrivée sur le site : la synchronisation lit un succès des heures après son déblocage, et
  /// c'est elle qui dit s'il est nouveau pour les notifications.
  createdAt     DateTime    @default(now())

  @@id([userId, achievementId])
  @@index([unlockedAt])
  @@index([userId, createdAt])
  @@index([createdAt, userId, achievementId])
  @@index([achievementId])
}

model SyncRun {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     Provider
  status       SyncStatus @default(QUEUED)
  games        Int        @default(0)
  achievements Int        @default(0)
  error        String?
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?

  @@index([userId, startedAt])
}

// ── Communauté ─────────────────────────────────────────────────────────

/// Un guide porte sur un succès, ou sur tout un jeu (`gameId`) : jamais les deux à la fois.
model Guide {
  id            String        @id @default(cuid())
  achievementId String?
  achievement   Achievement?  @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  /// Guide complet du jeu, à suivre du début à la fin pour tout obtenir.
  gameId        String?
  game          Game?         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  /// Titre des guides de jeu ; les guides de succès s'en passent.
  title         String?
  authorId      String
  author        User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  contentMd     String
  /// Langue du site de l'auteur à la publication ; vide pour les textes plus anciens.
  locale        String?
  status        ContentStatus @default(PUBLISHED)
  score         Int           @default(0)
  /// Renseigné sur les guides officiels, importés depuis le dépôt.
  curatedKey    String?       @unique
  /// Le texte du dépôt au dernier import (titre compris pour un guide de jeu). Tant que le fichier
  /// ne change pas, l'import garde les modifications faites sur le site par un modérateur.
  curatedSource String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  votes        GuideVote[]
  checks       GuideCheck[]
  comments     Comment[]
  translations ContentTranslation[]

  @@index([achievementId, score])
  @@index([gameId, score])
}

/// Une case cochée par un joueur, repérée par son rang dans le guide.
model GuideCheck {
  guideId String
  guide   Guide  @relation(fields: [guideId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  item    Int

  @@id([guideId, userId, item])
}

model GuideVote {
  guideId String
  guide   Guide  @relation(fields: [guideId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  value   Int

  @@id([guideId, userId])
}

model Comment {
  id            String        @id @default(cuid())
  /// Sous un succès, ou sous un guide complet de jeu : l'un ou l'autre, jamais les deux.
  achievementId String?
  achievement   Achievement?  @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  guideId       String?
  guide         Guide?        @relation(fields: [guideId], references: [id], onDelete: Cascade)
  authorId      String
  author        User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId      String?
  parent        Comment?      @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]     @relation("Replies")
  contentMd     String
  /// Langue du site de l'auteur à la publication ; vide pour les textes plus anciens.
  locale        String?
  status        ContentStatus @default(PUBLISHED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  reactions    CommentReaction[]
  translations ContentTranslation[]

  @@index([achievementId, createdAt])
  @@index([guideId, createdAt])
}

/// Traductions automatiques, supprimées avec le texte d'origine.
model ContentTranslation {
  id        String   @id @default(cuid())
  guideId   String?
  guide     Guide?   @relation(fields: [guideId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  locale    String
  contentMd String
  createdAt DateTime @default(now())

  @@unique([guideId, locale])
  @@unique([commentId, locale])
}

model CommentReaction {
  commentId String
  comment   Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType

  @@id([commentId, userId])
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType ReportTarget
  targetId   String
  reason     String
  /// La modération a retiré le contenu signalé.
  upheld     Boolean      @default(false)
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())

  @@unique([reporterId, targetType, targetId])
  @@index([resolvedAt])
}

/// Un jeton de service posé à la main sur le serveur (le NPSSO du PSN) : il expire sans prévenir.
model ServiceToken {
  name        String    @id
  /// Empreinte du jeton, jamais le jeton : elle repère son remplacement.
  fingerprint String
  since       DateTime  @default(now())
  okAt        DateTime?
  failedAt    DateTime?
  error       String?
}

/// Un site partenaire (Lure…) qui lit l'API publique `/api/v1` avec sa clé.
model PartnerApp {
  id         String    @id @default(cuid())
  name       String    @unique
  /// Empreinte SHA-256 de la clé, jamais la clé : elle ne s'affiche qu'à sa création.
  keyHash    String    @unique
  /// Début de la clé, pour la reconnaître dans la liste sans la révéler.
  keyPrefix  String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  /// Le nom du partenaire dans `PartnerLink.partner` (« lure ») : les joueurs reliés à lui.
  slug                       String?   @unique
  /// Adresse HTTPS où envoyer les nouveaux succès des joueurs reliés ; vide, rien ne part.
  webhookUrl                 String?
  /// Secret de signature HMAC, chiffré : il faut le relire pour signer chaque envoi.
  webhookSecret              String?
  /// Arrivée sur le site du dernier succès déjà envoyé : la suite part de là.
  webhookCursor              DateTime?
  webhookCursorUserId        String?
  webhookCursorAchievementId String?
  /// Échecs d'affilée : chacun double l'attente avant le prochain essai.
  webhookFailures            Int       @default(0)
  webhookLastAttemptAt       DateTime?
  webhookLastError           String?

  /// Identifiant public du client OAuth : « Se connecter avec Achievers » chez le partenaire.
  oauthClientId     String?        @unique
  /// Empreinte du secret client, jamais le secret : il ne s'affiche qu'à sa création.
  oauthSecretHash   String?
  /// Adresses de retour acceptées, comparées à l'identique : aucune autre ne reçoit de code.
  oauthRedirectUris String[]       @default([])
  oauthGrants       OAuthGrant[]
  events            PartnerEvent[]
}

/// Ce qu'un partenaire doit apprendre d'un compte : relié, délié, modifié. Envoyé par webhook,
/// avec les succès, et gardé jusqu'à ce que le partenaire l'ait reçu.
model PartnerEvent {
  id            String     @id @default(cuid())
  appId         String
  app           PartnerApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// user.linked, user.unlinked ou user.updated
  type          String
  /// AUTO (identités communes) ou OAUTH (« Se connecter avec Achievers ») ; vide pour updated.
  via           String?
  /// Le compte partenaire au moment de l'événement : après une déliaison, le lien n'existe plus.
  partnerUserId String?
  createdAt     DateTime   @default(now())
  deliveredAt   DateTime?

  @@index([appId, deliveredAt, createdAt])
}

/// L'accord d'un joueur à un partenaire : ce qu'il lui laisse lire, jusqu'à ce qu'il le retire.
model OAuthGrant {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  appId     String
  app       PartnerApp   @relation(fields: [appId], references: [id], onDelete: Cascade)
  /// profile, library, achievements
  scopes    String[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  revokedAt DateTime?
  tokens    OAuthToken[]

  @@unique([userId, appId])
}

/// Codes d'autorisation, jetons d'accès et de rafraîchissement : seule leur empreinte est gardée.
model OAuthToken {
  id            String     @id @default(cuid())
  grantId       String
  grant         OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  /// CODE, ACCESS ou REFRESH
  kind          String
  hash          String     @unique
  scopes        String[]
  expiresAt     DateTime
  /// Un code ou un rafraîchissement ne sert qu'une fois : le réemploi trahit un vol.
  usedAt        DateTime?
  /// Codes seulement : le défi PKCE et l'adresse de retour à présenter de nouveau.
  codeChallenge String?
  redirectUri   String?
  createdAt     DateTime   @default(now())

  @@index([grantId])
}

/// Ce que Lure sait d'un jeu Steam, relu au plus une fois par semaine : sa fiche et le temps qu'il
/// faut pour le finir. `found` faux : Lure ne connaît pas le jeu (ou sa route n'existe pas encore).
model LureGame {
  steamAppId           String   @id
  found                Boolean
  url                  String?
  mainMinutes          Int?
  normalMinutes        Int?
  completionistMinutes Int?
  fetchedAt            DateTime
}

/// Le parcours de connexion, sans donnée personnelle : ni joueur, ni adresse IP. Sert à voir où
/// les visiteurs décrochent (départ vers le fournisseur, inscription, connexion, échec et sa raison).
/// Gardé 90 jours.
model AuthEvent {
  id        String   @id @default(cuid())
  /// steam, discord, google, xbox, blizzard, epic
  provider  String
  /// START, SIGNUP, LOGIN ou ERROR
  kind      String
  /// Pour ERROR : expire, annule, fournisseur, refuse, deja_lie
  reason    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
