# ── Project Achievers — environment variables ────────────────────────────────
# Copy this file to `.env` (project root) or `src-tauri/.env` and fill the
# values. Neither `.env` file is committed to git.

# Steam Web API key — https://steamcommunity.com/dev/apikey
# Used by the library/achievement sync (platform_accounts + STEAM_API_KEY).
STEAM_API_KEY=

# Steam OAuth 2.0 application — https://steamcommunity.com/dev
# The redirect URI is generated at runtime as a local loopback
# (http://127.0.0.1:<port>/callback). Register that exact URI with the provider.
STEAM_CLIENT_ID=
STEAM_CLIENT_SECRET=
STEAM_SCOPES=openid profile email

# Discord OAuth 2.0 application — https://discord.com/developers/applications
# Add `http://127.0.0.1:42813/callback` to the allowed redirect URIs.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_SCOPES=identify email

# Steam OAuth redirect (for browser-based OAuth)
STEAM_REDIRECT_URI=http://localhost:5177/auth/callback

# Discord OAuth redirect (for browser-based OAuth)
DISCORD_REDIRECT_URI=http://localhost:5177/auth/callback
