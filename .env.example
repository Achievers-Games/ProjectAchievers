# Copier vers .env. Générer les secrets avec : openssl rand -hex 32

# Base de données et URL publique du site (obligatoires)
DATABASE_URL="postgresql://achievers:achievers@localhost:5433/achievers"
ORIGIN="http://localhost:3000"

# Clé de chiffrement des jetons OAuth : 32 octets en hexadécimal (obligatoire)
ENCRYPTION_KEY=

# Steam : https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Discord : https://discord.com/developers/applications
# Redirection à déclarer : {ORIGIN}/auth/discord/callback
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Google : https://console.cloud.google.com/auth/clients
# Redirection à déclarer : {ORIGIN}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Xbox : application Microsoft Entra (comptes personnels Microsoft)
# Redirection à déclarer : {ORIGIN}/auth/xbox/callback
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=

# PlayStation : NPSSO d'un compte de service dédié, jamais celui d'un utilisateur.
# Il sert à lire les trophées publics à partir de l'identifiant PSN des joueurs.
PSN_SERVICE_NPSSO=

# Bot Discord sans serveur, pour suivre les avatars et décorations, optionnel
DISCORD_BOT_TOKEN=

# Clé web : https://retroachievements.org/controlpanel.php, section Keys
RETRO_API_KEY=

# Notifications : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT="mailto:contact@example.com"

# Traduction des guides et commentaires, analyse des emblèmes de clan (Cloudflare Workers AI), optionnelle
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# Formulaire de contact : envoi par SMTP, optionnel.
# Gmail : mot de passe d'application (compte avec validation en deux étapes), pas le mot de passe du compte.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="contact@achievers.games"
SMTP_FROM_NAME="Project Achievers"
# Boîte qui reçoit les messages. Par défaut, SMTP_FROM.
CONTACT_INBOX="contact@achievers.games"

# Site partenaire (Lure) : liaison automatique des comptes par les identités OAuth communes.
# L'URL est la base du site ; l'appel vise /api/v1/partner/identities/lookup.
# Sans ces deux valeurs, aucune liaison automatique n'est tentée.
LURE_API_URL=
LURE_API_KEY=

