# ============================================================================
# Project Achievers - Backend Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ============================================================================

# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL="file:./dev.db"
# For production with PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/project_achievers?schema=public"

# ============================================================================
# SERVER
# ============================================================================
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# Generate with: openssl rand -hex 32
JWT_SECRET="your-32-character-jwt-secret-key-here"
JWT_REFRESH_SECRET="your-32-character-refresh-secret-key-here"

# ============================================================================
# ENCRYPTION (for OAuth tokens)
# ============================================================================
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="your-32-character-encryption-key-here!!"

# ============================================================================
# STEAM API
# ============================================================================
# Get Steam API key from: https://steamcommunity.com/dev/apikey
STEAM_API_KEY="your-steam-web-api-key"

# For Steam OAuth (requires Steamworks partnership)
# For OpenID 2.0 (no partnership needed):
STEAM_OPENID_REALM="http://localhost:3001"
STEAM_OPENID_RETURN_TO="http://localhost:3001/api/steam/oauth/callback"

# If you have Steamworks partnership for OAuth2:
STEAM_CLIENT_ID="your-steam-client-id"
STEAM_CLIENT_SECRET="your-steam-client-secret"
STEAM_REDIRECT_URI="http://localhost:3001/api/steam/oauth/callback"

# ============================================================================
# DISCORD OAUTH
# ============================================================================
# Create application at: https://discord.com/developers/applications
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"
DISCORD_REDIRECT_URI="http://localhost:3001/api/discord/oauth/callback"
DISCORD_SCOPES="identify email"

# ============================================================================
# PLAYSTATION NETWORK (PSN)
# ============================================================================
# PSN doesn't have a public API. Options:
# 1. NPSSO token (user-provided, limited)
# 2. PSNProfiles.com community API (unofficial)
# 3. Private PSN API (requires Sony partnership)

# For PSNProfiles import (community API, no key needed):
# PSN_PROFILES_API_KEY="optional"

# ============================================================================
# OPTIONAL: EXTERNAL SERVICES
# ============================================================================

# AI Guide Generation (optional - for local LLM or cloud API)
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# LOCAL_LLM_URL="http://localhost:11434"  # Ollama
# LOCAL_LLM_MODEL="phi3:mini"

# Email (for notifications, password reset)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# EMAIL_FROM="Project Achievers <noreply@projectachievers.com>"

# Redis (for PKCE verifier storage, sessions, caching - production)
# REDIS_URL="redis://localhost:6379"

# Sentry (error tracking)
# SENTRY_DSN="https://xxx@sentry.io/xxx"

# ============================================================================
# PRODUCTION SETTINGS
# ============================================================================
# NODE_ENV=production
# FRONTEND_URL="https://your-domain.com"
# COOKIE_DOMAIN=".your-domain.com"
# COOKIE_SECURE=true